# ACP Graduation Test Environment
# Copy to .env and fill in values from app.virtuals.io/acp

# Shared dev wallet private key (with 0x prefix)
WHITELISTED_WALLET_PRIVATE_KEY=0x...

# Seller agent (0xLaVaN - our main agent)
SELLER_AGENT_WALLET_ADDRESS=0x898cBaE072a9Fd4973aD716aC2696C63DE8bc3c2
SELLER_ENTITY_ID=

# Test buyer agent (create at app.virtuals.io/acp/join)
BUYER_AGENT_WALLET_ADDRESS=
BUYER_ENTITY_ID=

# Service to test (use keyword to find our agent)
TEST_SERVICE_KEYWORD=solidity_audit
TEST_PRICE=0.01
